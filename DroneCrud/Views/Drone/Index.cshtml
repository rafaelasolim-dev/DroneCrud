@model IEnumerable<DroneCrud.Models.Drone>

@{
    ViewData["Title"] = "Index";
}

<h1>Lista de Drones</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Cadastrar</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Modelo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Preco)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Helice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataCadastro)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Modelo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Preco)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Helice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataCadastro)
            </td>
            <td>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.IdDrone">Editar</a> 
                    <a class="btn btn-warning" asp-action="Details" asp-route-id="@item.IdDrone">Detalhes</a> 
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.IdDrone">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
